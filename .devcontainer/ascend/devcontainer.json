{
  "name": "SDC Ascend",
  "build": {
    "dockerfile": "../../environment/docker/Dockerfile",
    "context": "../..",
    "target": "ascend",
    "options": ["--network=host", "--allow=network.host"],
    "args": {
      "ASCEND_SOC": "${localEnv:SDC_ASCEND_SOC:910b}"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/SDC,type=bind",
  "workspaceFolder": "/workspace/SDC",
  "containerEnv": {
    "PYTHONPATH": "/workspace/SDC/src",
    "ASCEND_RT_VISIBLE_DEVICES": "${localEnv:SDC_ASCEND_VISIBLE_DEVICES:0}"
  },
  "runArgs": [
    "--shm-size=8g",
    "--network=host",
    "--device=/dev/davinci0",
    "--device=/dev/davinci_manager",
    "--device=/dev/devmm_svm",
    "--device=/dev/hisi_hdc",
    "--group-add=${localEnv:SDC_ASCEND_GID:1000}"
  ],
  "mounts": [
    "source=sdc-codex-${devcontainerId},target=/home/sdc/.codex,type=volume",
    "source=sdc-ai-tools-${devcontainerId},target=/home/sdc/.local,type=volume",
    "source=sdc-ssh-${devcontainerId},target=/home/sdc/.ssh,type=volume",
    "source=sdc-cache-${devcontainerId},target=/home/sdc/.cache,type=volume",
    "type=bind,source=/usr/local/Ascend/driver,target=/usr/local/Ascend/driver,readonly"
  ],
  "forwardPorts": [
    6006,
    8888
  ],
  "portsAttributes": {
    "6006": {
      "label": "TensorBoard",
      "onAutoForward": "silent"
    },
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "silent"
    }
  },
  "init": true,
  "remoteUser": "sdc",
  "updateRemoteUserUID": true,
  "overrideCommand": true,
  "shutdownAction": "stopContainer",
  "postCreateCommand": "python /opt/sdc/project/environment/verify_environment.py --project /workspace/SDC --smoke",
  "postStartCommand": "sh /opt/sdc/setup-codex.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "ruff.path": [
          "/opt/venv/bin/ruff"
        ]
      }
    }
  }
}
